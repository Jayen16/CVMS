APP_NAME="RHU CVMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# Public URL used when the instance is online. Facility/offline instances use
# APP_URL for links instead.
APP_PUBLIC_URL=http://localhost
APP_INSTANCE_TYPE=facility
ACTIVATION_CODE_TTL_HOURS=24

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

OFFLINE_ENABLED=true

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_TIMEOUT=15
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Local seeded accounts after `php artisan db:seed`
# admin@example.com / password123
# nurse@example.com / password123
# parent@example.com / password123

VACCINATION_REMINDERS_ENABLED=true
VACCINATION_REMINDER_LOOKAHEAD_DAYS=7
VACCINATION_REMINDER_CHANNELS=email

LARAVEL_PDF_DRIVER=dompdf
LARAVEL_PDF_DOMPDF_REMOTE_ENABLED=false

# SMS_DRIVER may be "log", "api", or "unisms".
SMS_DRIVER=log
SMS_API_URL=
SMS_API_TOKEN=
SMS_API_FROM=
SMS_API_TIMEOUT=15

# UniSMS uses Basic Auth: the secret key is the username and the password is empty.
UNISMS_BASE_URL=https://unismsapi.com/api
UNISMS_API_SECRET_KEY=
UNISMS_SENDER_ID=
UNISMS_WEBHOOK_SECRET_KEY=
UNISMS_TIMEOUT=15

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
